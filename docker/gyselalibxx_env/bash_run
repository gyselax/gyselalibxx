#!/bin/bash
# SPDX-License-Identifier: MIT

if [ -f /ci/spack/share/spack/setup-env.sh ]; then
    . /ci/spack/share/spack/setup-env.sh
fi

# Activate virtual environment if it exists and not already active
if [ -d /opt/venv ] && [ -z "$VIRTUAL_ENV" ]; then
    source /opt/venv/bin/activate
fi

exec "$@"
