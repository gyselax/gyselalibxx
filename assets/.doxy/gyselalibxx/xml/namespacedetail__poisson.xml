<parameteritem>
<parameternamelist>
<parametername direction="in">idx_range_basis</parametername>
</parameternamelist>
<parameterdescription>
<para>The index range of the B-splines in the basis. In a periodic dimension this must contain all the B-splines. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
