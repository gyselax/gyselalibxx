        <name>value</name>
        <qualifiedname>connectivity_details::PatchIdsAreUnique&lt; ddc::TypeSeq&lt; Patches... &gt; &gt;::value</qualifiedname>
        <initializer>= []() {
        std::array&lt;std::size_t, sizeof...(Patches)&gt; const ids {Patches::id...};
        for (std::size_t i = 0; i &lt; ids.size(); ++i) {
            for (std::size_t j = i + 1; j &lt; ids.size(); ++j) {
                if (ids[i] == ids[j]) {
                    return false;
                }
            }
        }
        return true;
    }()</initializer>
